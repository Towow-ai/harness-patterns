{
  "permissions": {
    "deny": [
      "Bash(git tag:*)",
      "Bash(git update-ref:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command":
              "\"$CLAUDE_PROJECT_DIR\"/scripts/guard-verifier-write.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command":
              "\"$CLAUDE_PROJECT_DIR\"/scripts/stop-gate.sh"
          }
        ]
      }
    ]
  }
}
