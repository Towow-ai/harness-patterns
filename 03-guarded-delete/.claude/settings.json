{
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "failIfUnavailable": true
  },
  "permissions": {
    "deny": ["Edit(/records/**)"]
  },
  "hooks": {
    "PreToolUse": [{
      "matcher": "Bash",
      "hooks": [{
        "type": "command",
        "command":
          "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.sh",
        "onFailure": "block"
      }]
    }]
  }
}
